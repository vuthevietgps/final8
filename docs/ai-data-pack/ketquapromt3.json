  "decision_gate_impacts": [
    {
      "gate": "can_conclude_profit",
      "rule": "false when required orders, payments, ad costs, settlement or returns freshness/coverage fails"
    },
    {
      "gate": "can_recommend_ads_scale",
      "rule": "false when ads, attribution, product mapping, finance or required settlement fails"
    },
    {
      "gate": "can_use_ltv_strongly",
      "rule": "remains false until durable customer/order/referral mapping and fresh coverage exist"
    },
    {
      "gate": "can_generate_action_draft",
      "rule": "may remain true but draft carries freshness blocks and no live authority"
    },
    {
      "gate": "can_import_action_file",
      "rule": "must remain false in PR-2.3B"
    },
