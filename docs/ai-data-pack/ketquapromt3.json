  "export_modes": [
    {
      "mode": "official_export",
      "default_sync_policy": "sync_required",
      "default_allow_partial_export": false,
      "behavior": "Strict critical-source freshness and coverage gate; allowlisted read-only sync only; block on unresolved critical failure."
    },
    {
      "mode": "partial_export",
      "default_sync_policy": "sync_if_stale",
      "default_allow_partial_export": true,
      "behavior": "May export with explicit warnings, blocking reasons and lowered decision gates."
    },
    {
      "mode": "cached_export",
      "default_sync_policy": "export_cached",
      "default_allow_partial_export": true,
      "behavior": "Never sync; technical/test use; cached flag required."
    }
  ],
