  "public_surface_contract": [
    {
      "surface": "internal_service_method",
      "purpose": "Start prepared export job.",
      "required_permission": "service identity plus mode create permission",
      "input_fields": ["mode", "reportDate", "packTypes", "formats", "redactionProfile", "requester", "idempotencyKey"],
      "forbidden_input_fields": ["raw token", "raw provider query", "mutation payload", "action plan", "dryRun", "liveExecution"],
      "output_fields": ["jobId", "status", "redactionProfile", "warnings"],
      "redaction_behavior": "service does not return artifact bytes",
      "audit_event": "export_requested",
      "rate_limit_idempotency": "idempotency by requester/mode/date/pack/formats/profile",
      "security_denial_behavior": "fail closed with sanitized reason"
    },
    {
      "surface": "future_admin_director_create_endpoint",
      "purpose": "Request official, partial, or cached export.",
      "required_permission": "create permission by mode",
      "input_fields": ["exportMode", "reportDate", "packTypes", "formats", "redactionProfile", "idempotencyKey"],
      "forbidden_input_fields": ["provider credentials", "provider query", "action plan", "approval payload", "dry-run/live flags"],
      "output_fields": ["jobId", "status", "policyVersion", "redactionProfile"],
      "redaction_behavior": "no sensitive section data in create response",
      "audit_event": "export_requested",
      "rate_limit_idempotency": "per actor and idempotency key",
      "security_denial_behavior": "403 with generic message and rbac_denied audit"
    },
    {
      "surface": "future_status_endpoint",
      "purpose": "Read export status.",
      "required_permission": "ai-data-pack.export.status.read",
      "input_fields": ["jobId"],
      "forbidden_input_fields": ["artifact storage path", "token override"],
      "output_fields": ["status", "mode", "sanitizedWarnings", "allowedNextActions"],
      "redaction_behavior": "profile-bound status and no raw sync payload",
      "audit_event": "sync_detail_viewed if detailed",
      "rate_limit_idempotency": "read rate limit per actor/job",
      "security_denial_behavior": "404 or 403 without leaking job existence policy"
    },
    {
      "surface": "future_download_endpoint",
      "purpose": "Download artifact.",
      "required_permission": "ai-data-pack.export.artifact.download plus profile match",
      "input_fields": ["artifactId or downloadToken"],
      "forbidden_input_fields": ["raw storage path", "redaction override", "permanent link request"],
      "output_fields": ["file stream or denial"],
      "redaction_behavior": "artifact is pre-generated for profile; never re-expand at download",
      "audit_event": "artifact_downloaded or download_denied",
      "rate_limit_idempotency": "token use count and expiry enforced",
      "security_denial_behavior": "deny and audit exact mismatch internally"
    },
    {
      "surface": "future_sync_detail_endpoint",
      "purpose": "Inspect source-sync details.",
      "required_permission": "ai-data-pack.export.sync-detail.read",
      "input_fields": ["jobId", "sourceKey"],
      "forbidden_input_fields": ["raw provider response", "credential fields"],
      "output_fields": ["sourceKey", "status", "attempts", "sanitizedErrorCategories", "postAssessment"],
      "redaction_behavior": "sanitized categories only",
      "audit_event": "sync_detail_viewed",
      "rate_limit_idempotency": "read rate limit per actor/job",
      "security_denial_behavior": "403 and rbac_denied audit"
    },
    {
      "surface": "future_audit_endpoint",
      "purpose": "Inspect export audit events.",
      "required_permission": "ai-data-pack.export.audit.read",
      "input_fields": ["jobId", "artifactId", "timeRange"],
      "forbidden_input_fields": ["secret filters", "raw payload filters"],
      "output_fields": ["sanitizedAuditEvents"],
      "redaction_behavior": "no secret, no raw provider payload, no stack trace",
      "audit_event": "sensitive_section_accessed",
      "rate_limit_idempotency": "read rate limit per actor/time range",
      "security_denial_behavior": "403 with sanitized response"
    }
  ],
  "artifact_manifest_policy": {
    "required_fields": [
      "artifactId",
      "exportJobId",
      "exportMode",
      "syncPolicy",
      "policyVersion",
      "redactionProfile",
      "sectionAccessProfile",
      "packTypes",
      "formats",
      "rowCounts",
      "sourceFreshnessMetadata",
      "sourceCoverageMetadata",
      "decisionGates",
      "warnings",
      "blockingReasons",
      "containsPii",
      "containsFinancialSensitive",
      "containsEmployeeSensitive",
      "containsSupplierSensitive",
      "dataContentChecksum",
      "runtimeExportChecksum",
      "artifactChecksum",
      "createdAt",
      "expiresAt",
      "retentionUntil",
      "storageLocation",
      "downloadPolicy"
    ],
    "storage_location_rule": "internal storage key only, never public URL or absolute local path",
    "forbidden_manifest_content": ["raw secrets", "raw provider payloads", "OAuth tokens", "refresh tokens", "stack traces", "unscoped raw PII"],
    "checksum_policy": "dataContentChecksum excludes runtime metadata; runtimeExportChecksum includes runtime metadata; artifactChecksum covers bytes"
  },
  "download_policy": {
    "token_type": "short_lived_download_token",
    "recommended_expiry_minutes": 15,
    "default_use_policy": "one_time",
    "multi_use_policy": "requires explicit internal policy, max use count, and audit reason",
    "authorization_checks": ["requester match or delegated permission", "artifact download permission", "redaction profile match", "artifact not expired", "token not revoked", "token not consumed"],
    "revocation_behavior": "revoked token denies future downloads and records download_denied",
    "failed_authorization_behavior": "generic denial to caller with internal audit metadata",
    "forbidden": ["public unauthenticated link", "permanent link", "download without audit", "download ignoring redaction profile"]
  },
  "audit_events": [
    "export_requested",
    "pre_assessment_started",
    "source_sync_started",
    "source_sync_completed",
    "post_assessment_completed",
    "export_blocked",
