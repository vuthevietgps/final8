  "response_redaction_policy": [
    {
      "profile": "director_full",
      "status_visibility": "full job status, sanitized provider status, manifest summary",
      "sync_summary": "allowed if permission granted",
      "omitted_sections": ["raw tokens", "raw provider payload", "stack trace"],
      "must_label_redacted": false
    },
    {
      "profile": "director_redacted",
      "status_visibility": "full workflow status with sensitive sections redacted",
      "sync_summary": "sanitized only if permission granted",
      "omitted_sections": ["raw PII", "raw tokens", "raw provider payload"],
      "must_label_redacted": true
    },
    {
      "profile": "manager_marketer",
      "status_visibility": "assigned partial/cached jobs only",
      "sync_summary": "denied by default",
      "omitted_sections": ["finance", "employee", "supplier commission", "customer PII", "sync detail"],
      "must_label_redacted": true
    },
    {
      "profile": "finance_operator",
      "status_visibility": "assigned finance-scoped jobs",
      "sync_summary": "sanitized only if granted",
      "omitted_sections": ["customer PII by default", "raw provider payload", "employee detail by default"],
      "must_label_redacted": true
    },
    {
      "profile": "reviewer_partial",
      "status_visibility": "assigned partial jobs only",
      "sync_summary": "denied by default",
      "omitted_sections": ["finance detail", "supplier commission", "customer PII", "employee sensitive", "sync detail"],
      "must_label_redacted": true
    },
    {
      "profile": "investor_redacted",
      "status_visibility": "assigned redacted summary only",
      "sync_summary": "denied",
      "omitted_sections": ["full Director Pack", "customer PII", "employee sensitive", "supplier detail", "finance detail", "sync detail", "audit detail"],
      "must_label_redacted": true
    },
    {
      "profile": "external_consultant_redacted",
      "status_visibility": "assigned redacted summary only",
      "sync_summary": "denied",
      "omitted_sections": ["finance detail", "customer PII", "employee sensitive", "supplier commission", "sync detail", "audit detail"],
      "must_label_redacted": true
    },
    {
      "profile": "system_internal_worker",
      "status_visibility": "no human read surface by default",
      "sync_summary": "no human read surface",
      "omitted_sections": ["all human endpoint data"],
      "must_label_redacted": true
    }
  ],
  "rbac_denial_policy": [
    {
      "case": "missing permission",
      "behavior": "fail closed, generic denial, audit exact permission internally, no source sync on denied create"
    },
    {
      "case": "profile mismatch",
      "behavior": "fail closed, audit requested and actor profiles, do not leak sensitive sections"
    },
    {
      "case": "artifact profile mismatch",
      "behavior": "deny; download remains out of scope but status must not expose artifact details"
    },
    {
      "case": "job owner mismatch",
      "behavior": "403 or 404-style denial according to security policy, audit internal reason"
    },
    {
      "case": "unassigned reviewer",
      "behavior": "deny status/detail/sync summary by default"
    },
    {
      "case": "investor trying full pack",
      "behavior": "deny, require investor_redacted assigned artifact policy in later phase"
    },
    {
      "case": "manager trying finance/employee detail",
      "behavior": "deny or omit sections and label response redacted"
    },
    {
      "case": "system worker trying human download/read",
      "behavior": "deny by default; system worker cannot use human read/download surfaces"
    }
  ],
