    "rules": [
      "fail closed if permission/profile mismatch",
      "do not return artifact bytes",
      "do not return download token",
      "create response returns job summary only",
      "official/partial call internal lifecycle method only",
      "cached keeps cached behavior and never triggers source sync",
      "no provider call outside internal lifecycle policy",
      "no action/import/dry-run/live gate opens",
      "no silent downgrade unless allowDowngradeToPartial=true"
    ],
    "response_fields": [
      "jobId",
      "exportMode",
      "syncPolicy",
      "status",
      "createdAt",
      "redactionProfile",
      "sectionAccessProfile",
