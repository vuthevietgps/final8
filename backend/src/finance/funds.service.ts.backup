/**
 * FUNDS SERVICE - Quáº£n lÃ½ 4 Quá»¹ theo Spec Chuáº©n
 * ==================================================
 * 
 * KIáº¾N TRÃšC CÃC QUá»¸ (FUNDS ARCHITECTURE):
 * 1. QUá»¸ Äáº¶T CHá»– (Committed Cash) - Tiá»n Ä‘Ã£ cÃ³ CHá»¦ nhÆ°ng CHÆ¯A chi
 * 2. QUá»¸ ADS (Growth Capital) - Nguá»“n duy nháº¥t Ä‘Æ°á»£c phÃ©p cháº¡y ads
 * 3. QUá»¸ Dá»° PHÃ’NG (Survival Buffer) - Äá»‡m chá»‘ng sá»‘c há»‡ thá»‘ng
 * 4. QUá»¸ OWNER (Thu nháº­p) - Tiá»n thá»±c sá»± thuá»™c vá» chá»§
 * 
 * Má»–I QUá»¸ CÃ“ 5 Lá»šP Dá»® LIá»†U:
 * - Flow (HÃ´m qua): Î” tÄƒng/giáº£m
 * - Stock (LÅ©y káº¿): Sá»‘ dÆ° hiá»‡n táº¡i
 * - Projection (7-15 ngÃ y): Æ¯á»›c tÃ­nh tÆ°Æ¡ng lai
 * - Threshold (NgÆ°á»¡ng): Má»©c an toÃ n / cáº£nh bÃ¡o
 * - Permission (Quyá»n): Ai Ä‘Æ°á»£c dÃ¹ng, Ä‘iá»u kiá»‡n nÃ o
 */

import { Injectable, Logger } from '@nestjs/common';
import { InjectModel } from '@nestjs/mongoose';
import { Model } from 'mongoose';
import { TestOrder2, TestOrder2Document } from '../test-order2/schemas/test-order2.schema';
import { FundingSource, FundingSourceDocument } from './schemas/funding-source.schema';
import { LoanContract, LoanContractDocument } from './schemas/loan-contract.schema';

// ===== INTERFACES =====

/**
 * Dá»¯ liá»‡u 5 lá»›p cá»§a má»—i quá»¹
 */
export interface FundLayer {
  // 1. Flow (HÃ´m qua)
  flow: {
    yesterday: number;        // Sá»‘ tiá»n tÄƒng/giáº£m hÃ´m qua
    reason?: string;          // LÃ½ do tÄƒng/giáº£m
  };
  
  // 2. Stock (LÅ©y káº¿)
  stock: {
    current: number;          // Sá»‘ dÆ° hiá»‡n táº¡i
    asOf: Date;               // Thá»i Ä‘iá»ƒm tÃ­nh
  };
  
  // 3. Projection (7-15 ngÃ y)
  projection: {
    days7: number;            // Æ¯á»›c tÃ­nh sau 7 ngÃ y
    days15: number;           // Æ¯á»›c tÃ­nh sau 15 ngÃ y
    trend: 'up' | 'down' | 'stable';
    dailyAverage: number;     // Trung bÃ¬nh ngÃ y
  };
  
  // 4. Threshold (NgÆ°á»¡ng)
  threshold: {
    min: number;              // NgÆ°á»¡ng tá»‘i thiá»ƒu
    max: number;              // NgÆ°á»¡ng tá»‘i Ä‘a
    status: 'safe' | 'warning' | 'danger';
    daysUntilMin?: number;    // Sá»‘ ngÃ y Ä‘áº¿n ngÆ°á»¡ng min
  };
  
  // 5. Permission (Quyá»n)
  permission: {
    canUse: boolean;          // CÃ³ Ä‘Æ°á»£c dÃ¹ng khÃ´ng
    allowedFor: string[];     // DÃ¹ng cho viá»‡c gÃ¬
    blockedFor: string[];     // KhÃ´ng Ä‘Æ°á»£c dÃ¹ng cho viá»‡c gÃ¬
    approvalRequired: boolean; // Cáº§n duyá»‡t khÃ´ng
  };
}

/**
 * Quá»¹ Äáº·t Chá»— (Committed Cash)
 */
export interface CommittedCashFund extends FundLayer {
  breakdown: {
    unpaidLaborCost: number;      // LÆ°Æ¡ng chÆ°a tráº£
    unpaidOtherCost: number;      // Chi phÃ­ váº­n hÃ nh chÆ°a thanh toÃ¡n
    unpaidAgentCommission: number; // Hoa há»“ng Ä‘áº¡i lÃ½ chÆ°a tráº£
  };
}

/**
 * Quá»¹ Ads (Growth Capital)
 */
export interface AdsFund extends FundLayer {
  breakdown: {
    fromInitialCapital: number;   // 45% vá»‘n ban Ä‘áº§u
    fromReinvestment: number;     // 45% lá»£i nhuáº­n tÃ¡i Ä‘áº§u tÆ°
    adsSpent: number;             // ÄÃ£ chi ads
    remaining: number;            // CÃ²n láº¡i
  };
  dailyBudget: {
    suggested: number;            // Budget Ä‘á» xuáº¥t/ngÃ y
    actual: number;               // Budget thá»±c táº¿/ngÃ y
    daysRemaining: number;        // Sá»‘ ngÃ y cÃ³ thá»ƒ cháº¡y
  };
}

/**
 * Quá»¹ Dá»± PhÃ²ng (Survival Buffer)
 */
export interface SurvivalBufferFund extends FundLayer {
  breakdown: {
    fromProfit: number;           // 20% lá»£i nhuáº­n thuáº§n
    used: number;                 // ÄÃ£ sá»­ dá»¥ng (emergency)
    remaining: number;            // CÃ²n láº¡i
  };
  survivalDays: number;           // Sá»‘ ngÃ y sá»‘ng sÃ³t náº¿u dá»«ng ads
}

/**
 * Quá»¹ Owner (Thu nháº­p)
 */
export interface OwnerFund extends FundLayer {
  breakdown: {
    fromProfit: number;           // 20% lá»£i nhuáº­n thuáº§n
    withdrawn: number;            // ÄÃ£ rÃºt
    retained: number;             // Giá»¯ láº¡i
  };
}

/**
 * Káº¿t quáº£ tÃ­nh toÃ¡n tá»•ng há»£p cÃ¡c quá»¹
 */
export interface FundsOverview {
  // Doanh thu (Net Revenue)
  revenue: {
    total: number;                // Tá»•ng doanh thu = COD thÃ nh cÃ´ng - tiá»n nháº­p hÃ ng
    realized: number;             // ÄÃ£ nháº­n tá»« NCC
    pending: number;              // Äang chá» NCC thanh toÃ¡n
    orderCount: number;           // Sá»‘ Ä‘Æ¡n
  };
  
  // Vá»‘n ban Ä‘áº§u (Seed Capital) - NGUá»’N, khÃ´ng pháº£i quá»¹
  seedCapital: {
    total: number;                // Tá»•ng vá»‘n vay/cÃ¡ nhÃ¢n
    allocated: number;            // ÄÃ£ phÃ¢n bá»•
    remaining: number;            // CÃ²n láº¡i
  };
  
  // 4 Quá»¹ cá»‘t lÃµi
  committedCash: CommittedCashFund;   // Quá»¹ Äáº·t Chá»—
  adsFund: AdsFund;                   // Quá»¹ Ads
  survivalBuffer: SurvivalBufferFund; // Quá»¹ Dá»± PhÃ²ng
  ownerFund: OwnerFund;               // Quá»¹ Owner
  
  // Lá»£i nhuáº­n thuáº§n (Ä‘á»ƒ phÃ¢n bá»•)
  netProfit: {
    realized: number;             // Lá»£i nhuáº­n thuáº§n Ä‘Ã£ thá»±c hiá»‡n
    pending: number;              // Lá»£i nhuáº­n thuáº§n Ä‘ang chá»
    total: number;                // Tá»•ng
  };
  
  // CÃ´ng thá»©c kiá»ƒm tra
  validation: {
    bankBalance: number;          // Tổng tiền ngân hàng hiện tại
    bankBalanceYesterday: number; // Số dư ngân hàng hôm qua
    bankBalanceDelta: number;     // Biến động (hôm nay - hôm qua)
    totalFunds: number;           // Tổng các quỹ
    difference: number;           // Chênh lệch (phải ≈ 0)
    isValid: boolean;             // Hệ thống có đúng không
  };
  
  // CÃ´ng thá»©c cá»‘t lÃµi
  formulas: {
    tienTuDo: number;             // TienTuDo = TongTienNganHang â€“ QuyDatCho
    adsBudgetAllowed: number;     // AdsBudgetAllowed = min(QuyAds, TienTuDo)
  };
  
  calculatedAt: Date;
}

@Injectable()
export class FundsService {
  private readonly logger = new Logger(FundsService.name);

  constructor(
    @InjectModel(TestOrder2.name)
    private readonly orderModel: Model<TestOrder2Document>,
    @InjectModel(FundingSource.name)
    private readonly fundingSourceModel: Model<FundingSourceDocument>,
    @InjectModel(LoanContract.name)
    private readonly loanModel: Model<LoanContractDocument>,
  ) {}

  /**
   * TÃ­nh toÃ¡n tá»•ng há»£p cÃ¡c quá»¹ theo Spec chuáº©n
   */
  async computeFundsOverview(): Promise<FundsOverview> {
    try {
      // 1. TÃ­nh Doanh Thu (Net Revenue)
      const revenue = await this.computeRevenue();
      
      // 2. Láº¥y Vá»‘n ban Ä‘áº§u (Seed Capital)
      const seedCapital = await this.getSeedCapital();
      
      // 3. TÃ­nh Lá»£i nhuáº­n thuáº§n
      const netProfit = await this.computeNetProfit();
      
      // 4. TÃ­nh Quá»¹ Äáº·t Chá»— (Committed Cash)
      const committedCash = await this.computeCommittedCashFund();
      
      // 5. TÃ­nh Quá»¹ Ads (Growth Capital)
      const adsFund = await this.computeAdsFund(seedCapital.total, netProfit.realized);
      
      // 6. TÃ­nh Quá»¹ Dá»± PhÃ²ng (Survival Buffer)
      const survivalBuffer = await this.computeSurvivalBufferFund(netProfit.realized);
      
      // 7. TÃ­nh Quá»¹ Owner (Thu nháº­p)
      const ownerFund = await this.computeOwnerFund(netProfit.realized);
      
      // 8. TÃ­nh Sá»‘ dÆ° ngÃ¢n hÃ ng thá»±c táº¿ (Bank Balance)
      const bankBalance = await this.computeBankBalance(seedCapital.total);
      
      // 9. CÃ´ng thá»©c kiá»ƒm tra
      const totalFunds = committedCash.stock.current + adsFund.stock.current + 
                        survivalBuffer.stock.current + ownerFund.stock.current;
      
      // ===== 10. CÃ”NG THá»¨C Cá»T LÃ•I =====
      
      /**
       * TIá»€N KHáº¢ Dá»¤NG (Free Cash / Tiá»n Tá»± Do)
       * =====================================
       * CÃ”NG THá»¨C: Tiá»n kháº£ dá»¥ng = Sá»‘ dÆ° ngÃ¢n hÃ ng - Tiá»n Ä‘Ã£ cam káº¿t
       * 
       * Ã nghÄ©a:
       * - Sá»‘ tiá»n THá»°C Sá»° cÃ³ thá»ƒ chi tiÃªu ngay láº­p tá»©c
       * - ÄÃ£ trá»« Ä‘i táº¥t cáº£ cÃ¡c khoáº£n pháº£i tráº£ (lÆ°Æ¡ng, NCC, Ä‘áº¡i lÃ½ chÆ°a thanh toÃ¡n)
       * - ÄÃ¢y lÃ  sá»‘ tiá»n "an toÃ n" Ä‘á»ƒ quyáº¿t Ä‘á»‹nh chi tiÃªu má»›i
       * 
       * VÃ­ dá»¥:
       * - Sá»‘ dÆ° ngÃ¢n hÃ ng: 850M
       * - Tiá»n Ä‘Ã£ cam káº¿t: 320M (lÆ°Æ¡ng 150M + NCC chÆ°a tráº£ 120M + Ä‘áº¡i lÃ½ 50M)
       * â†’ Tiá»n kháº£ dá»¥ng = 850M - 320M = 530M âœ… (CÃ³ thá»ƒ dÃ¹ng)
       * 
       * âš ï¸ LÆ¯U Ã: KhÃ´ng bao giá» chi vÆ°á»£t quÃ¡ sá»‘ tiá»n kháº£ dá»¥ng!
       */
      const tienTuDo = bankBalance - committedCash.stock.current;
      
      /**
       * NGÃ‚N SÃCH ADS CHO PHÃ‰P (Ads Budget Allowed)
       * ==========================================
       * CÃ”NG THá»¨C: MIN(Quá»¹ Ads hiá»‡n cÃ³, Tiá»n kháº£ dá»¥ng)
       * 
       * Ã nghÄ©a:
       * - NgÃ¢n sÃ¡ch ads khÃ´ng Ä‘Æ°á»£c vÆ°á»£t quÃ¡ 2 giá»›i háº¡n:
       *   1. Quá»¹ ads cÃ²n láº¡i (Ä‘Ã£ Ä‘Æ°á»£c phÃ¢n bá»•)
       *   2. Tiá»n kháº£ dá»¥ng (trÃ¡nh áº£nh hÆ°á»Ÿng nghÄ©a vá»¥ khÃ¡c)
       * 
       * VÃ­ dá»¥:
       * - Quá»¹ Ads: 180M
       * - Tiá»n kháº£ dá»¥ng: 530M
       * â†’ Ads Budget Allowed = MIN(180M, 530M) = 180M
       * 
       * Náº¿u tiá»n kháº£ dá»¥ng < Quá»¹ Ads â†’ Bá»‹ giá»›i háº¡n bá»Ÿi dÃ²ng tiá»n!
       */
      const adsBudgetAllowed = Math.min(adsFund.stock.current, tienTuDo);

      // ===== TÍNH BANK BALANCE YESTERDAY & DELTA =====
      const yesterday = new Date();
      yesterday.setDate(yesterday.getDate() - 1);
      yesterday.setHours(23, 59, 59, 999); // End of yesterday
      
      const bankBalanceYesterday = await this.computeBankBalanceAsOf(yesterday, seedCapital.total);
      const bankBalanceDelta = bankBalance - bankBalanceYesterday;

      return {
        revenue,
        seedCapital,
        committedCash,
        adsFund,
        survivalBuffer,
        ownerFund,
        netProfit,
        validation: {
          bankBalance,
          bankBalanceYesterday,
          bankBalanceDelta,
          totalFunds,
          difference: Math.abs(bankBalance - totalFunds),
          isValid: Math.abs(bankBalance - totalFunds) < 1000 // Tolerance 1000Ä‘
        },
        formulas: {
          tienTuDo,
          adsBudgetAllowed
        },
        calculatedAt: new Date()
      };
    } catch (err) {
      this.logger.error('computeFundsOverview failed', err);
      throw err;
    }
  }

  /**
   * DOANH THU = COD giao thÃ nh cÃ´ng - tiá»n nháº­p hÃ ng
   * Chá»‰ ghi nháº­n khi: Ä‘Æ¡n Ä‘Ã£ chá»‘t + NCC Ä‘Ã£ thanh toÃ¡n
   */
  private async computeRevenue() {
    // 1. Doanh thu Ä‘Ã£ realized (NCC Ä‘Ã£ thanh toÃ¡n)
    const realizedResult = await this.orderModel.aggregate([
      { 
        $match: { 
          orderStatus: 'Giao thÃ nh cÃ´ng',
          supplierPaymentStatus: 'paid',
          codAmount: { $exists: true, $gt: 0 }
        } 
      },
      { 
        $group: { 
          _id: null,
          // Doanh thu = COD - tiá»n nháº­p hÃ ng (supplierAppliedPrice * quantity)
          totalRevenue: { 
            $sum: { 
              $subtract: [
                { $ifNull: ['$codAmount', 0] },
                { $multiply: [
                  { $ifNull: ['$supplierAppliedPrice', 0] },
                  { $ifNull: ['$quantity', 1] }
                ]}
              ]
            }
          },
          count: { $sum: 1 }
        } 
      }
    ]);
    
    const realizedRevenue = realizedResult?.[0]?.totalRevenue || 0;
    const realizedCount = realizedResult?.[0]?.count || 0;

    // 2. Doanh thu pending (Ä‘Æ¡n thÃ nh cÃ´ng nhÆ°ng NCC chÆ°a thanh toÃ¡n)
    const pendingResult = await this.orderModel.aggregate([
      { 
        $match: { 
          orderStatus: 'Giao thÃ nh cÃ´ng',
          supplierPaymentStatus: { $ne: 'paid' },
          codAmount: { $exists: true, $gt: 0 }
        } 
      },
      { 
        $group: { 
          _id: null,
          totalRevenue: { 
            $sum: { 
              $subtract: [
                { $ifNull: ['$codAmount', 0] },
                { $multiply: [
                  { $ifNull: ['$supplierAppliedPrice', 0] },
                  { $ifNull: ['$quantity', 1] }
                ]}
              ]
            }
          },
          count: { $sum: 1 }
        } 
      }
    ]);
    
    const pendingRevenue = pendingResult?.[0]?.totalRevenue || 0;
    const pendingCount = pendingResult?.[0]?.count || 0;

    return {
      total: realizedRevenue + pendingRevenue,
      realized: realizedRevenue,
      pending: pendingRevenue,
      orderCount: realizedCount + pendingCount
    };
  }

  /**
   * Vá»N BAN Äáº¦U (Seed Capital)
   * = Vá»‘n vay + Vá»‘n cÃ¡ nhÃ¢n bá» vÃ o
   */
  private async getSeedCapital() {
    // 1. Lấy vốn từ LoanContract (khoản vay)
    const loanResult = await this.loanModel.aggregate([
      { $match: { status: { $in: ['active', 'draft'] } } },
      { $group: { _id: null, total: { $sum: '$principal' } } }
    ]);
    const loanTotal = loanResult?.[0]?.total || 0;
    
    // 2. Lấy vốn từ FundingSource
    const fundingSources = await this.fundingSourceModel.aggregate([
      { $match: { status: 'active' } },
      {
        $group: {
          _id: null,
          total: { $sum: '$principal' },
          allocated: { $sum: { $ifNull: ['$allocatedAmount', 0] } }
        }
      }
    ]);

    const fundingTotal = fundingSources?.[0]?.total || 0;
    const allocated = fundingSources?.[0]?.allocated || 0;

    return {
      total: loanTotal + fundingTotal,
      allocated,
      remaining: loanTotal + fundingTotal - allocated
    };
  } },
      { 
        $group: { 
          _id: null, 
          total: { $sum: '$principal' },
          allocated: { $sum: { $ifNull: ['$allocatedAmount', 0] } }
        } 
      }
    ]);
    
    const total = fundingSources?.[0]?.total || 0;
    const allocated = fundingSources?.[0]?.allocated || 0;
    
    return {
      total,
      allocated,
      remaining: total - allocated
    };
  }

  /**
   * Lá»¢I NHUáº¬N THUáº¦N
   */
  private async computeNetProfit() {
    // 1. Realized (Ä‘Ã£ thanh toÃ¡n cáº£ 2 bÃªn)
    const realizedResult = await this.orderModel.aggregate([
      { 
        $match: { 
          realizedAt: { $exists: true, $ne: null },
          realizedNetProfit: { $exists: true }
        } 
      },
      { 
        $group: { 
          _id: null, 
          total: { $sum: '$realizedNetProfit' }
        } 
      }
    ]);
    const realized = realizedResult?.[0]?.total || 0;

    // 2. Pending (chá» thanh toÃ¡n)
    const pendingResult = await this.orderModel.aggregate([
      { 
        $match: { 
          orderStatus: { $in: ['Giao thÃ nh cÃ´ng', 'HÃ ng hoÃ n'] },
          realizedAt: { $in: [null, undefined] },
          netProfit: { $exists: true }
        } 
      },
      { 
        $group: { 
          _id: null, 
          total: { $sum: '$netProfit' }
        } 
      }
    ]);
    const pending = pendingResult?.[0]?.total || 0;

    return {
      realized,
      pending,
      total: realized + pending
    };
  }

  /**
   * â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   * Sá» DÆ¯ NGÃ‚N HÃ€NG (Bank Balance)
   * â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   * 
   * Äáº I DIá»†N CHO: Sá»‘ tiá»n THá»°C Táº¾ trong tÃ i khoáº£n ngÃ¢n hÃ ng táº¡i thá»i Ä‘iá»ƒm hiá»‡n táº¡i
   * 
   * â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
   * CÃ”NG THá»¨C Tá»”NG QUÃT:
   * â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
   * 
   * Bank Balance = Vá»‘n Äáº§u VÃ o + Doanh Thu Thá»±c Táº¿ - Chi PhÃ­ ÄÃ£ Chi
   * 
   * Hay:
   * Bank Balance = Initial Capital + Total Revenue - Total Actual Costs
   * 
   * â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
   * CHI TIáº¾T Tá»ªNG THÃ€NH PHáº¦N:
   * â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
   * 
