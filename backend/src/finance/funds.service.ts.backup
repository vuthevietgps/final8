   * Vá»‘n ban Ä‘áº§u:           1,000,000,000â‚«  (1 tá»·)
   * (+) Doanh thu:           500,000,000â‚«  (KhÃ¡ch Ä‘Ã£ tráº£, NCC Ä‘Ã£ thanh toÃ¡n)
   * (-) Chi NCC:            -300,000,000â‚«  (ÄÃ£ chuyá»ƒn tiá»n cho NCC)
   * (-) Hoa há»“ng Ä‘áº¡i lÃ½:     -50,000,000â‚«  (ÄÃ£ tráº£ sales)
   * (-) LÆ°Æ¡ng:              -100,000,000â‚«  (ÄÃ£ tráº£ nhÃ¢n viÃªn)
   * (-) Chi phÃ­ khÃ¡c:        -20,000,000â‚«  (Äiá»‡n, nÆ°á»›c, vÄƒn phÃ²ng Ä‘Ã£ thanh toÃ¡n)
   * (-) Chi phÃ­ ads:         -80,000,000â‚«  (ÄÃ£ cháº¡y ads)
   * â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   * = Sá»‘ dÆ° ngÃ¢n hÃ ng:       950,000,000â‚« âœ…
   * 
   * â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
   * NGUYÃŠN Táº®C QUAN TRá»ŒNG:
   * â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
   * 
   * âœ… CHá»ˆ TÃNH: Giao dá»‹ch ÄÃƒ HOÃ€N THÃ€NH (tiá»n Ä‘Ã£ vÃ o/ra thá»±c táº¿)
   * âŒ KHÃ”NG TÃNH: Khoáº£n dá»± kiáº¿n, chÆ°a thanh toÃ¡n (â†’ thuá»™c Committed Cash)
   * 
   * Bank Balance = "Tiá»n THáº¬T trong ngÃ¢n hÃ ng lÃºc nÃ y"
   * â‰  Tiá»n dá»± kiáº¿n cÃ³
   * â‰  Tiá»n sáº½ thu
   * â‰  Lá»£i nhuáº­n Æ°á»›c tÃ­nh
   * 
   * â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   * ═══════════════════════════════════════════════════════════════════════════
   */
  private async computeBankBalance(seedCapital: number): Promise<number> {
    // ═══════════════════════════════════════════════════════════════════════════
    // 📌 ĐỊNH NGHĨA CHUẨN: TIỀN TRONG NGÂN HÀNG = TIỀN VÀO - TIỀN RA
    // ═══════════════════════════════════════════════════════════════════════════
    //
    // ✅ TIỀN ĐÃ VÀO (Cash In) - BẤT KỲ khoản tiền nào ĐÃ THỰC SỰ vào tài khoản:
    // ──────────────────────────────────────────────────────────────────────────
    // 1️⃣ VỐN BAN ĐẦU / TIỀN VAY (seedCapital)
    //    - Tiền cá nhân nạp vào
    //    - Tiền vay ngân hàng / đối tác
    //    ✅ Làm tăng bankBalance
    //    ❌ KHÔNG phải doanh thu, KHÔNG phải lợi nhuận
    //
    // 2️⃣ DOANH THU ĐÃ THỰC HIỆN (supplierPaidAmount)
    //    - Tiền NCC chuyển cho công ty
    //    - ĐÃ TRỪ tiền nhập hàng (NCC giữ lại phần của họ)
    //    ✅ Làm tăng bankBalance
    //    ✅ Là doanh thu (net revenue)
    //    ❌ KHÔNG phải COD (COD là tiền khách trả NCC, không phải tiền vào công ty)
    //
    // ❌ KHÔNG ĐƯỢC TÍNH LÀ "TIỀN ĐÃ VÀO":
    //    - COD khách trả NCC
    //    - Doanh thu kế toán chưa thu tiền
    //    - Doanh thu dự kiến
    //    - Đơn chưa chốt
    //    - Công nợ phải thu
    //
    // ✅ TIỀN ĐÃ RA (Cash Out) - BẤT KỲ khoản tiền nào ĐÃ THỰC SỰ ra khỏi tài khoản:
    // ──────────────────────────────────────────────────────────────────────────
    // 1. Chi phí Ads đã chi
    // 2. Trả lương
    // 3. Trả chi phí khác (điện, nước, văn phòng...)
    // 4. Thanh toán cho đại lý (hoa hồng agent)
    // 5. Owner Fund đã rút (tiền chủ rút ra)
    //
    // ═══════════════════════════════════════════════════════════════════════════

    // ═══════════════════════════════════════════════════════════════════════════
    // 💰 TIỀN VÀO #2: DOANH THU = supplierPaidAmount (Tiền NCC gửi về)
    // ═══════════════════════════════════════════════════════════════════════════
    const revenueResult = await this.orderModel.aggregate([
      {
        $match: {
          supplierPaymentStatus: 'paid',
          supplierPaidAmount: { $exists: true }
        }
      },
      {
        $group: {
          _id: null,
          totalRevenue: { $sum: '$supplierPaidAmount' }
        }
      }
    ]);
    const totalRevenue = revenueResult?.[0]?.totalRevenue || 0;

    // ═══════════════════════════════════════════════════════════════════════════
    // 💸 TIỀN RA #4: HOA HỒNG ĐẠI LÝ ĐÃ TRẢ
    // ═══════════════════════════════════════════════════════════════════════════
    const agentCommissionResult = await this.orderModel.aggregate([
      {
        $match: {
          agentPaymentStatus: 'paid',
          agentPaidAmount: { $exists: true, $gt: 0 }
        }
      },
      {
        $group: {
          _id: null,
          total: { $sum: '$agentPaidAmount' }
        }
      }
    ]);
    const agentCommissionPaid = agentCommissionResult?.[0]?.total || 0;

    // ═══════════════════════════════════════════════════════════════════════════
    // 💸 TIỀN RA #2: LƯƠNG ĐÃ TRẢ (từ laborstatements với status='closed')
    // ═══════════════════════════════════════════════════════════════════════════
    const laborResult = await this.orderModel.db.collection('laborstatements').aggregate([
      { $match: { status: 'closed' } },
      {
        $group: {
          _id: null,
          total: {
            $sum: {
              $add: [
                { $ifNull: ['$openingBalance', 0] },
                { $ifNull: ['$periodCost', 0] },
                { $ifNull: ['$bonus', 0] },
                { $multiply: [{ $ifNull: ['$deduction', 0] }, -1] }
              ]
            }
          }
        }
      }
    ]).toArray();
    const laborCostPaid = laborResult?.[0]?.total || 0;

    // ═══════════════════════════════════════════════════════════════════════════
    // 💸 TIỀN RA #3: CHI PHÍ KHÁC ĐÃ XÁC NHẬN (isConfirmed = true)
    // ═══════════════════════════════════════════════════════════════════════════
    const otherCostResult = await this.orderModel.db.collection('othercosts').aggregate([
      { $match: { isConfirmed: true } },
      { $group: { _id: null, total: { $sum: '$amount' } } }
    ]).toArray();
    const otherCostConfirmed = otherCostResult?.[0]?.total || 0;

    // ═══════════════════════════════════════════════════════════════════════════
    // 💸 TIỀN RA #1: CHI PHÍ QUẢNG CÁO (từ advertisingcosts collection)
    // ═══════════════════════════════════════════════════════════════════════════
    const adsSpentResult = await this.orderModel.db.collection('advertisingcosts').aggregate([
      { $group: { _id: null, total: { $sum: '$spend' } } }
    ]).toArray();
    const adsSpent = adsSpentResult?.[0]?.total || 0;

    // ═══════════════════════════════════════════════════════════════════════════
    // 💸 TIỀN RA #5: OWNER FUND ĐÃ RÚT (từ capital_allocation_snapshots)
    // ═══════════════════════════════════════════════════════════════════════════
    const ownerWithdrawnResult = await this.orderModel.db.collection('capital_allocation_snapshots').aggregate([
      { $group: { _id: null, total: { $sum: { $ifNull: ['$personalIncomeWithdrawn', 0] } } } }
    ]).toArray();
    const ownerWithdrawn = ownerWithdrawnResult?.[0]?.total || 0;

    // ═══════════════════════════════════════════════════════════════════════════
    // 🏦 TÍNH SỐ DƯ NGÂN HÀNG
    // ═══════════════════════════════════════════════════════════════════════════
    // Công thức: Bank Balance = TIỀN VÀO - TIỀN RA
    //
    // 💰 TIỀN VÀO:
    // - Vốn ban đầu / Tiền vay (seedCapital)
    // - Doanh thu đã thực hiện (supplierPaidAmount - tiền NCC gửi về)
    //
    // 💸 TIỀN RA:
    // - Chi phí Ads đã chi
    // - Trả lương
    // - Trả chi phí khác
    // - Thanh toán cho đại lý (hoa hồng agent)
    // - Owner Fund đã rút
    // ═══════════════════════════════════════════════════════════════════════════
    const totalCashIn = seedCapital + totalRevenue;
    const totalCashOut = adsSpent + laborCostPaid + otherCostConfirmed + agentCommissionPaid + ownerWithdrawn;
    const bankBalance = totalCashIn - totalCashOut;

    this.logger.log(`💰 Bank Balance Calculation (Tiền Trong Ngân Hàng):`);
    this.logger.log(`  ────────── TIỀN VÀO ──────────`);
    this.logger.log(`  Vốn ban đầu (Loan + Funding): ${seedCapital.toLocaleString('vi-VN')}đ`);
    this.logger.log(`  Doanh thu (NCC gửi về): ${totalRevenue.toLocaleString('vi-VN')}đ`);
    this.logger.log(`  → Tổng tiền vào: ${totalCashIn.toLocaleString('vi-VN')}đ`);
    this.logger.log(`  ────────── TIỀN RA ──────────`);
    this.logger.log(`  Chi phí Ads: -${adsSpent.toLocaleString('vi-VN')}đ`);
    this.logger.log(`  Trả lương: -${laborCostPaid.toLocaleString('vi-VN')}đ`);
    this.logger.log(`  Chi phí khác: -${otherCostConfirmed.toLocaleString('vi-VN')}đ`);
    this.logger.log(`  Hoa hồng đại lý: -${agentCommissionPaid.toLocaleString('vi-VN')}đ`);
    this.logger.log(`  Owner rút: -${ownerWithdrawn.toLocaleString('vi-VN')}đ`);
    this.logger.log(`  → Tổng tiền ra: -${totalCashOut.toLocaleString('vi-VN')}đ`);
    this.logger.log(`  ──────────────────────────────────────`);
    this.logger.log(`  🏦 SỐ DƯ NGÂN HÀNG: ${bankBalance.toLocaleString('vi-VN')}đ`);

    return Math.max(0, bankBalance);
  }

  /**
   * TÍNH SỐ DƯ NGÂN HÀNG TẠI THỜI ĐIỂM CỤ THỂ
   * Dùng để tính Bank Balance hôm qua, hoặc bất kỳ ngày nào trong quá khứ
   */
  private async computeBankBalanceAsOf(endDate: Date, seedCapital: number): Promise<number> {
    // ═══════════════════════════════════════════════════════════════════════════
    // DOANH THU = supplierPaidAmount (đã thanh toán TRƯỚC endDate)
    // ═══════════════════════════════════════════════════════════════════════════
    const revenueResult = await this.orderModel.aggregate([
      {
        $match: {
          supplierPaymentStatus: 'paid',
          supplierPaidAt: { $lte: endDate },
          supplierPaidAmount: { $exists: true }
        }
      },
      {
        $group: {
          _id: null,
          totalRevenue: { $sum: '$supplierPaidAmount' }
        }
      }
    ]);
    const totalRevenue = revenueResult?.[0]?.totalRevenue || 0;

    // ═══════════════════════════════════════════════════════════════════════════
    // HOA HỒNG ĐẠI LÝ ĐÃ TRẢ (trước endDate)
    // ═══════════════════════════════════════════════════════════════════════════
    const agentCommissionResult = await this.orderModel.aggregate([
      {
        $match: {
          agentPaymentStatus: 'paid',
          agentPaidAt: { $lte: endDate },
          agentPaidAmount: { $exists: true, $gt: 0 }
        }
      },
      {
        $group: {
          _id: null,
          total: { $sum: '$agentPaidAmount' }
        }
      }
    ]);
    const agentCommissionPaid = agentCommissionResult?.[0]?.total || 0;

    // ═══════════════════════════════════════════════════════════════════════════
    // LƯƠNG ĐÃ TRẢ (kỳ lương đã đóng trước endDate)
    // ═══════════════════════════════════════════════════════════════════════════
    const laborResult = await this.orderModel.db.collection('laborstatements').aggregate([
      { 
        $match: { 
          status: 'closed',
          closedAt: { $lte: endDate }
        } 
      },
      {
        $group: {
          _id: null,
          total: {
            $sum: {
              $add: [
                { $ifNull: ['$openingBalance', 0] },
                { $ifNull: ['$periodCost', 0] },
                { $ifNull: ['$bonus', 0] },
                { $multiply: [{ $ifNull: ['$deduction', 0] }, -1] }
              ]
            }
          }
        }
      }
    ]).toArray();
    const laborCostPaid = laborResult?.[0]?.total || 0;

    // ═══════════════════════════════════════════════════════════════════════════
    // CHI PHÍ KHÁC ĐÃ XÁC NHẬN (trước endDate)
    // ═══════════════════════════════════════════════════════════════════════════
    const otherCostResult = await this.orderModel.db.collection('othercosts').aggregate([
      { 
        $match: { 
          isConfirmed: true,
          confirmedAt: { $lte: endDate }
        } 
      },
      { $group: { _id: null, total: { $sum: '$amount' } } }
    ]).toArray();
    const otherCostConfirmed = otherCostResult?.[0]?.total || 0;

    // ═══════════════════════════════════════════════════════════════════════════
    // CHI PHÍ QUẢNG CÁO (trước endDate)
    // ═══════════════════════════════════════════════════════════════════════════
    const adsSpentResult = await this.orderModel.db.collection('advertisingcosts').aggregate([
      { 
        $match: {
          date: { $lte: endDate }
        }
      },
      { $group: { _id: null, total: { $sum: '$spend' } } }
    ]).toArray();
    const adsSpent = adsSpentResult?.[0]?.total || 0;

    // ═══════════════════════════════════════════════════════════════════════════
    // OWNER FUND ĐÃ RÚT (trước endDate)
    // ═══════════════════════════════════════════════════════════════════════════
    const ownerWithdrawnResult = await this.orderModel.db.collection('capital_allocation_snapshots').aggregate([
      { 
        $match: {
          date: { $lte: endDate }
        }
      },
      { $group: { _id: null, total: { $sum: { $ifNull: ['$personalIncomeWithdrawn', 0] } } } }
    ]).toArray();
    const ownerWithdrawn = ownerWithdrawnResult?.[0]?.total || 0;

    // ═══════════════════════════════════════════════════════════════════════════
    // TÍNH SỐ DƯ NGÂN HÀNG TẠI endDate
    // ═══════════════════════════════════════════════════════════════════════════
    const totalCashIn = seedCapital + totalRevenue;
    const totalCashOut = adsSpent + laborCostPaid + otherCostConfirmed + agentCommissionPaid + ownerWithdrawn;
    const bankBalance = totalCashIn - totalCashOut;

    return Math.max(0, bankBalance);
  }

  private async computeCommittedCashFund(): Promise<CommittedCashFund> {
    // 1. LÆ°Æ¡ng chÆ°a tráº£ - Tá»« LaborStatement
    const unpaidLaborResult = await this.orderModel.db.collection('laborstatements').aggregate([
      { $match: { status: { $in: ['draft', 'open'] } } },
      { $group: { _id: null, total: { $sum: '$closingBalance' } } }
    ]).toArray();
    const unpaidLaborCost = unpaidLaborResult?.[0]?.total || 0;

    // 2. Chi phÃ­ váº­n hÃ nh CHÆ¯A THANH TOÃN (isConfirmed = false)
    // â†’ ÄÃ£ phÃ¡t sinh nghÄ©a vá»¥ nhÆ°ng chÆ°a chi thá»±c táº¿
    // â†’ Ghi nháº­n vÃ o Committed Cash Ä‘á»ƒ "Ä‘áº·t chá»—" tiá»n
    const unpaidOtherResult = await this.orderModel.db.collection('othercosts').aggregate([
      { $match: { isConfirmed: { $ne: true } } },
      { $group: { _id: null, total: { $sum: '$amount' } } }
    ]).toArray();
    const unpaidOtherCost = unpaidOtherResult?.[0]?.total || 0;

    // 3. Hoa há»“ng Ä‘áº¡i lÃ½ chÆ°a tráº£
    const unpaidAgentResult = await this.orderModel.aggregate([
      { 
        $match: { 
          orderStatus: { $in: ['Giao thÃ nh cÃ´ng', 'HÃ ng hoÃ n'] },
          agentPaymentStatus: 'pending',
          agentQuote: { $gt: 0 }
        } 
      },
      { 
        $group: { 
          _id: null, 
          total: { $sum: { $multiply: ['$agentQuote', { $ifNull: ['$quantity', 1] }] } }
        } 
      }
    ]);
    const unpaidAgentCommission = unpaidAgentResult?.[0]?.total || 0;

    const totalCommitted = unpaidLaborCost + unpaidOtherCost + unpaidAgentCommission;

    // TÃ­nh Flow (hÃ´m qua) - cáº§n snapshot trÆ°á»›c
    const yesterday = await this.getYesterdayCommitted();
    const flowYesterday = totalCommitted - yesterday;

    return {
      breakdown: {
        unpaidLaborCost,
        unpaidOtherCost,
        unpaidAgentCommission
      },
      flow: {
        yesterday: flowYesterday,
        reason: flowYesterday > 0 ? 'NghÄ©a vá»¥ tÄƒng' : flowYesterday < 0 ? 'ÄÃ£ thanh toÃ¡n' : 'KhÃ´ng Ä‘á»•i'
      },
      stock: {
        current: totalCommitted,
        asOf: new Date()
      },
      projection: {
        days7: totalCommitted * 1.1, // Æ¯á»›c tÃ­nh tÄƒng 10%
        days15: totalCommitted * 1.2,
        trend: flowYesterday > 0 ? 'up' : flowYesterday < 0 ? 'down' : 'stable',
        dailyAverage: Math.abs(flowYesterday)
      },
      threshold: {
        min: 0,
        max: totalCommitted * 2, // Cáº£nh bÃ¡o náº¿u vÆ°á»£t 2x
        status: totalCommitted < 50000000 ? 'safe' : totalCommitted < 100000000 ? 'warning' : 'danger',
        daysUntilMin: undefined
      },
      permission: {
        canUse: false,
        allowedFor: ['Tráº£ lÆ°Æ¡ng', 'Tráº£ chi phÃ­ váº­n hÃ nh', 'Tráº£ hoa há»“ng Ä‘áº¡i lÃ½'],
        blockedFor: ['Cháº¡y ads', 'Chi tiÃªu cÃ¡ nhÃ¢n', 'Äáº§u tÆ°'],
        approvalRequired: true
      }
    };
  }

  /**
   * QUá»¸ ADS (Growth Capital)
   * = 45% vá»‘n ban Ä‘áº§u + 45% lá»£i nhuáº­n thuáº§n tÃ¡i Ä‘áº§u tÆ° - ads Ä‘Ã£ chi
   */
  private async computeAdsFund(seedCapital: number, realizedProfit: number): Promise<AdsFund> {
    // TÃ­nh nguá»“n
    const fromInitialCapital = Math.round(seedCapital * 0.45);
    const fromReinvestment = Math.round(realizedProfit * 0.45);
    
    // Ads Ä‘Ã£ chi (tá»•ng lÅ©y káº¿ tá»« Ä‘Æ¡n hÃ ng)
    const adsSpentResult = await this.orderModel.aggregate([
      { 
        $match: { 
          advertisingCost: { $exists: true, $gt: 0 }
        } 
      },
      { 
        $group: { 
          _id: null, 
          total: { $sum: '$advertisingCost' }
        } 
      }
    ]);
    const adsSpent = adsSpentResult?.[0]?.total || 0;
    
    const totalAvailable = fromInitialCapital + fromReinvestment;
    const remaining = Math.max(0, totalAvailable - adsSpent);

    // ===== CHI PHÃ ADS NGÃ€Y HÃ”M QUA (tá»« collection advertisingcosts) =====
    const yesterday = new Date();
    yesterday.setDate(yesterday.getDate() - 1);
    yesterday.setHours(0, 0, 0, 0);
    const endOfYesterday = new Date(yesterday);
    endOfYesterday.setHours(23, 59, 59, 999);

    const yesterdayResult = await this.orderModel.db.collection('advertisingcosts').aggregate([
      { 
        $match: { 
          date: { $gte: yesterday, $lte: endOfYesterday }
        }
      },
      { 
        $group: { 
          _id: null, 
          total: { $sum: '$spentAmount' }
        } 
      }
    ]).toArray();
    const yesterdaySpent = yesterdayResult?.[0]?.total || 0;

    // ===== TRUNG BÃŒNH 7 NGÃ€Y (Ä‘á»ƒ tÃ­nh projection) =====
    const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
    const dailyAdsResult = await this.orderModel.db.collection('advertisingcosts').aggregate([
      { 
        $match: { 
          date: { $gte: sevenDaysAgo }
        }
      },
      { 
        $group: { 
          _id: null, 
          total: { $sum: '$spentAmount' }, 
          days: { $addToSet: '$date' } 
        } 
      }
    ]).toArray();
    const avgDailySpend = dailyAdsResult?.[0] 
      ? dailyAdsResult[0].total / (dailyAdsResult[0].days?.length || 7)
      : 0;
    const daysRemaining = avgDailySpend > 0 ? Math.floor(remaining / avgDailySpend) : 999;

    return {
      breakdown: {
        fromInitialCapital,
        fromReinvestment,
        adsSpent,
        remaining
      },
      flow: {
        yesterday: -Math.abs(yesterdaySpent), // Chi phÃ­ ads thá»±c táº¿ ngÃ y hÃ´m qua (luÃ´n Ã¢m)
        reason: `Chi phÃ­ quáº£ng cÃ¡o ngÃ y hÃ´m qua: ${yesterdaySpent.toLocaleString('vi-VN')} Ä‘`
      },
      stock: {
        current: remaining,
        asOf: new Date()
      },
      projection: {
        days7: remaining - avgDailySpend * 7,
        days15: remaining - avgDailySpend * 15,
        trend: 'down',
        dailyAverage: avgDailySpend
      },
      threshold: {
        min: avgDailySpend * 3, // Tá»‘i thiá»ƒu 3 ngÃ y
        max: totalAvailable,
        status: daysRemaining >= 7 ? 'safe' : daysRemaining >= 3 ? 'warning' : 'danger',
        daysUntilMin: daysRemaining
      },
      permission: {
        canUse: true,
        allowedFor: ['Cháº¡y ads Facebook', 'Cháº¡y ads Google', 'Cháº¡y ads TikTok'],
        blockedFor: ['Tráº£ lÆ°Æ¡ng', 'Chi tiÃªu cÃ¡ nhÃ¢n', 'Tráº£ hoa há»“ng'],
        approvalRequired: false
      },
      dailyBudget: {
        suggested: Math.min(remaining / 7, avgDailySpend * 1.2), // KhÃ´ng tÄƒng quÃ¡ 20%
        actual: avgDailySpend,
        daysRemaining
      }
    };
  }

  /**
   * QUá»¸ Dá»° PHÃ’NG (Survival Buffer)
   * = 20% lá»£i nhuáº­n thuáº§n
   */
  private async computeSurvivalBufferFund(realizedProfit: number): Promise<SurvivalBufferFund> {
    const fromProfit = Math.round(realizedProfit * 0.20);
    const used = 0; // TODO: Track emergency usage
    const remaining = fromProfit - used;

    // TÃ­nh sá»‘ ngÃ y sá»‘ng sÃ³t
    const dailyCostResult = await this.orderModel.db.collection('othercosts').aggregate([
      { 
        $match: { 
          date: { $gte: new Date(Date.now() - 30 * 24 * 60 * 60 * 1000) }
        }
      },
      { $group: { _id: null, total: { $sum: '$amount' }, days: { $addToSet: '$date' } } }
    ]).toArray();
    const avgDailyCost = dailyCostResult?.[0] 
      ? dailyCostResult[0].total / (dailyCostResult[0].days?.length || 30)
      : 0;
    const survivalDays = avgDailyCost > 0 ? Math.floor(remaining / avgDailyCost) : 999;

    return {
      breakdown: {
        fromProfit,
        used,
        remaining
      },
      flow: {
        yesterday: 0,
        reason: 'KhÃ´ng sá»­ dá»¥ng'
      },
      stock: {
        current: remaining,
        asOf: new Date()
      },
      projection: {
        days7: remaining,
        days15: remaining,
        trend: 'stable',
        dailyAverage: 0
      },
      threshold: {
        min: avgDailyCost * 14, // Tá»‘i thiá»ƒu 2 tuáº§n
        max: avgDailyCost * 30, // Tá»‘i Ä‘a 1 thÃ¡ng
        status: survivalDays >= 14 ? 'safe' : survivalDays >= 7 ? 'warning' : 'danger',
        daysUntilMin: survivalDays
      },
      permission: {
        canUse: false, // Máº·c Ä‘á»‹nh khÃ´ng Ä‘Æ°á»£c dÃ¹ng
        allowedFor: ['Sá»± cá»‘ cashflow', 'Emergency'],
        blockedFor: ['Cháº¡y ads', 'Scale', 'Chi tiÃªu thÆ°á»ng xuyÃªn'],
        approvalRequired: true
      },
      survivalDays
    };
  }

  /**
   * QUá»¸ OWNER (Thu nháº­p)
   * = 20% lá»£i nhuáº­n thuáº§n
   */
  private async computeOwnerFund(realizedProfit: number): Promise<OwnerFund> {
    const fromProfit = Math.round(realizedProfit * 0.20);
    const withdrawn = 0; // TODO: Track withdrawals
    const retained = fromProfit - withdrawn;

    return {
      breakdown: {
        fromProfit,
        withdrawn,
        retained
      },
      flow: {
        yesterday: 0,
        reason: 'ChÆ°a rÃºt'
      },
      stock: {
        current: retained,
        asOf: new Date()
      },
      projection: {
        days7: retained,
        days15: retained,
        trend: 'stable',
        dailyAverage: 0
      },
      threshold: {
        min: 0,
        max: fromProfit * 2,
        status: 'safe',
        daysUntilMin: undefined
      },
      permission: {
        canUse: true,
        allowedFor: ['RÃºt tiá»n cÃ¡ nhÃ¢n', 'TÃ i sáº£n dÃ i háº¡n'],
        blockedFor: ['Cháº¡y ads', 'Tráº£ lÆ°Æ¡ng', 'Chi phÃ­ váº­n hÃ nh'],
        approvalRequired: false
      }
    };
  }

  /**
   * Helper: Láº¥y committed cash hÃ´m qua (tá»« snapshot)
   */
