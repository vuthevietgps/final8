FROM node:20-alpine AS build
WORKDIR /app
COPY backend/package.json backend/package-lock.json ./
RUN npm ci
COPY backend/tsconfig*.json backend/nest-cli.json ./
COPY backend/src ./src
RUN npm run build

# Keep the deployed application unchanged outside the tracking module.
FROM htxbachgia/backend:20260909-deploy
COPY --from=build /app/dist/tracking-crm /app/dist/tracking-crm
